rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Clientes não escrevem direto — apenas o servidor (Firebase Admin) grava pedidos.
    match /orders/{orderId} {
      allow read: if false;
      allow write: if false;
    }

    match /subscriptions/{emailId} {
      allow read: if false;
      allow write: if false;
    }

    match /payments/{paymentId} {
      allow read: if false;
      allow write: if false;
    }

    match /users/{userId} {
      allow read: if false;
      allow write: if false;
    }

    match /sessions/{sessionId} {
      allow read: if false;
      allow write: if false;
    }

    match /access_emails/{emailId} {
      allow read: if false;
      allow write: if false;
    }

    match /hotmart_events/{eventId} {
      allow read: if false;
      allow write: if false;
    }
  }
}
