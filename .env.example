# Configurações do Servidor
PORT=3000

# URL pública do app (opcional — na Vercel usa VERCEL_URL automaticamente)
APP_URL=https://conectwm.vercel.app

# E-mails admin (além do padrão clozednebulous1k@gmail.com). Separados por vírgula.
ADMIN_EMAILS=clozednebulous1k@gmail.com

# Chave de API da OpenAI (opcional)
OPENAI_API_KEY=

# Webhook CRM (opcional)
WEBHOOK_CRM_URL=https://api.conectwm.com.br/webhook/diagnostico

# =============================================
# FIREBASE — Firestore (pedidos e assinaturas)
# =============================================
# Opção A (recomendada Vercel): cole o JSON completo da service account em uma linha
# Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opção B: variáveis separadas
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================
# HOTMART — Webhook pós-compra (login automático)
# =============================================
# Painel Hotmart → Ferramentas → Webhook → URL:
# https://conectwm.vercel.app/api/webhooks/hotmart
# Versão: 2.0.0 | Eventos: Compra aprovada + Compra completa + Cancelamento/Reembolso
# Token exibido no painel Hotmart (validação hottok):
HOTMART_HOTTOK=
# Opcional: filtrar só este produto (ID numérico Hotmart)
HOTMART_PRODUCT_ID=
# Simular compra Hotmart localmente: POST /api/webhooks/hotmart/simulate
HOTMART_ALLOW_SIMULATE=true

# Webhook opcional para enviar e-mail de login (n8n, Make, Resend gateway)
ACCESS_EMAIL_WEBHOOK_URL=
