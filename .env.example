# Configurações do Servidor
PORT=3000

# Chave de API da OpenAI (opcional)
OPENAI_API_KEY=

# Webhook CRM (opcional)
WEBHOOK_CRM_URL=https://api.conectwm.com.br/webhook/diagnostico

# =============================================
# FIREBASE — Firestore (pedidos e assinaturas)
# =============================================
# Opção A (recomendada Vercel): cole o JSON completo da service account em uma linha
# Firebase Console → Configurações do projeto → Contas de serviço → Gerar nova chave privada
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opção B: variáveis separadas
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
